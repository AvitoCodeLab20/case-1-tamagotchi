# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tamagotchi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# Backend
HTTP_ADDR=:8080
BACKEND_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DATABASE_CONNECT_TIMEOUT=5s

# Authentication
# JWT_SECRET has no default: the backend refuses to start without it.
# The value below is for local development only. Generate a fresh one per
# environment with `openssl rand -base64 48` and keep it in secret storage.
JWT_SECRET=local-development-only-change-me-before-deploy
JWT_ISSUER=avito-tamagotchi
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12

# Frontend (used when the frontend Compose profile is enabled)
FRONTEND_PORT=3000
